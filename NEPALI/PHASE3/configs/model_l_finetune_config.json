{
  "language": "nepali",
  "model_tier": "Model L",
  "vocab_size": 12000,
  "d_model": 512,
  "n_layer": 6,
  "n_head": 8,
  "d_ff": 2048,
  "max_seq_len": 512,
  "dropout": 0.1,
  "tie_weights": true,
  "_comment_max_seq_len": "Must match the pretrained checkpoint's positional embedding table size (512); the reasoning examples themselves are packed to finetune_max_seq_len below.",
  "finetune_max_seq_len": 128,
  "learning_rate": 0.00001,
  "weight_decay": 0.01,
  "betas": [0.9, 0.95],
  "batch_size": 16,
  "max_steps": 3000,
  "warmup_steps": 150,
  "grad_clip": 1.0,
  "eval_interval": 150,
  "save_interval": 300,
  "milestone_interval": 300,
  "early_stopping_patience": 12,
  "use_template_rebalancing": true,
  "easy_templates": ["transitive"],
  "hard_templates": ["pairwise", "threeway"],
  "curriculum_easy_weight_start": 3.0,
  "curriculum_easy_weight_end": 1.0,
  "curriculum_hard_weight_start": 1.0,
  "curriculum_hard_weight_end": 3.0,
  "pretrained_checkpoint": "PHASE2/checkpoints/checkpoint_final.pt",
  "tokenizer_path": "PHASE2/tokenizer/nepali_bpe.model"
}
